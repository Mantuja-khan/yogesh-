# ==========================================
# SS PRODUCTION HOUSE - BACKEND ENVIRONMENT
# ==========================================

# Port for the Express server
PORT=5006

# Client frontend URL for CORS (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:8080,http://localhost:5173

# Recipient Email for incoming client inquiries
NOTIFICATION_EMAIL=acc.ssproductionhouse@gmail.com

# SMTP Email Configuration (Nodemailer)
# For Gmail: Use an App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="SS Production House" <acc.ssproductionhouse@gmail.com>

# Storage mode ('file' stores in backend/data/contacts.json)
STORAGE_MODE=file

